# .env.example (ACTUALIZAR)
# ============================================================
# CONFIGURACIÓN GENERAL
# ============================================================
ENTORNO=desarrollo
NIVEL_LOG=INFO
PROYECTO_NOMBRE=Orion
PROYECTO_VERSION=1.0.0

# ============================================================
# RUTAS DE DATOS
# ============================================================
RUTA_DATOS_BRUTOS=datos/brutos
RUTA_DATOS_PROCESADOS=datos/procesados
RUTA_DATOS_MUESTRA=datos/muestra
RUTA_DATOS_INSPECCION=datos/inspeccion
RUTA_DATOS_RETROALIMENTACION=datos/retroalimentacion
RUTA_DATOS_COLA=datos/cola
RUTA_DATOS_PASADOS=datos_pasados

# ============================================================
# RUTAS DE MODELOS
# ============================================================
RUTA_MODELOS=modelos/actual
RUTA_MODELOS_HISTORICO=modelos/historico

# ============================================================
# CONFIGURACIÓN DEL MODELO
# ============================================================
MODELO_TIPO=isolation_forest
MODELO_UMBRAL=0.7
MODELO_SEMILLA=42

# ============================================================
# CONFIGURACIÓN DE PRIORIZACIÓN
# ============================================================
PRIORIZACION_FASE=fase1

# ============================================================
# CONFIGURACIÓN DEL CLOSED LOOP
# ============================================================
BUCLE_MINIMO_MUESTRAS=50
BUCLE_MAXIMO_DIAS=30
BUCLE_UMBRAL_PRECISION=0.85

# ============================================================
# CONFIGURACIÓN DE LA API
# ============================================================
API_HOST=127.0.0.1
API_PUERTO=8000
API_RECARGAR=true

# ============================================================
# CONFIGURACIÓN DE INSPECCIÓN
# ============================================================
INSPECCION_INTERVALO=30
INSPECCION_MAX_INTENTOS=3

# ============================================================
# GOOGLE SHEETS (para inspección)
# ============================================================
GOOGLE_SHEETS_CREDENTIALS=configuracion/credentials.json
GOOGLE_SHEETS_ID=

# ============================================================
# EMAIL (para alertas)
# ============================================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=orion@empresa.com
EMAIL_PASSWORD=
EMAIL_RECIPIENTS=equipo@empresa.com